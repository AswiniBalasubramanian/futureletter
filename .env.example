# Copy to .env and fill in ONE way to send mail. With neither set, letters are
# written to data/mail/*.eml instead, which is handy for testing.

# Option A: Resend (https://resend.com) — verify your sending domain there first
RESEND_API_KEY=
# Option B: any SMTP server, e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=

# Who the letters come from (must be allowed by your provider)
MAIL_FROM="Future Love Letter <letters@yourdomain.com>"

# Optional
PORT=8787
DB_PATH=data/letters.db
TICK_MS=60000
LETTERS_PER_HOUR=10
# set to 1 if the server sits behind a proxy that sets X-Forwarded-For
TRUST_PROXY=

# Translation in the editor (Claude). Or run `ant auth login` instead of setting a key.
ANTHROPIC_API_KEY=
