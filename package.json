{
  "name": "future-love-letter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc -p . && tsc -p server && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "preview": "vite preview",
    "server:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "cuelume": "^0.2.8",
    "motion": "^14.6.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
